# ROSTR Agent Environment Variables
# Copy to .env and fill in your values

# ── Backend ──────────────────────────────────────────────────
PORT=8080
ROSTR_HUB_PATH=./.rostr

# ── API Keys (BYOK — user brings their own) ──────────────────
# Default API key for development (users provide their own in production)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
WORKSPACE_BUCKET_PREFIX=rostr-workspace

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_ROSTR_API_URL=http://localhost:8080
NEXT_PUBLIC_LLM_PROVIDER=openai
NEXT_PUBLIC_BYOK_KEY=
