# Vercel AI Gateway (preferred door for System Two generation)
# On a Vercel deploy, VERCEL_OIDC_TOKEN is injected automatically.
AI_GATEWAY_API_KEY=
# XAI_API_KEY=                 # Grok BYOK / preview fallback

# Jev (System One). TYPESAFE_API_KEY is the real model.
# TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=          # optional Jev wire

# Legacy last-resort providers (only if the gateway door is closed)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

ROSTR_ENV=production
ROSTR_VERSION=1.1.0
